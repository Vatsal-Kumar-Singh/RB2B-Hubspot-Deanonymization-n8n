# === Webhooks ===
# Zapier catch webhook URLs — used to ping AEs on high-intent visits
# Create at: https://zapier.com/app/zaps (Webhooks by Zapier → Catch Hook)
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/YOUR_ID/YOUR_PATH/

# === Enrichment ===
# Clay endpoint URL (a Clay webhook source you've configured in your Clay table)
# Get from: your Clay table → Add Source → Webhook
CLAY_WEBHOOK_URL=https://api.clay.com/v1/...

# === CRM ===
# HubSpot credentials are configured directly in n8n's credential store via OAuth
# (no env var needed)

# === Inbound ===
# The RB2B-facing webhook URL is generated by n8n when the workflow is activated.
# Copy the production URL from the Webhook node in n8n and paste it into
# your RB2B account: rb2b.com → Integrations → Webhook
